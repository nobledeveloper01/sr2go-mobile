# Copy to .env. The .env file is gitignored and must never be committed.
EXPO_PUBLIC_API_BASE_URL=https://shareride2go.com

# WARNING about EXPO_PUBLIC_ variables.
#
# These are not runtime secrets. Metro substitutes them into the JavaScript at
# build time, so anything here ends up as a readable string inside the shipped
# app bundle. Gitignoring this file protects the repository, not the binary.
#
# Never put a real secret in an EXPO_PUBLIC_ variable.
#
# The two below are only used to prefill the sign in form, and only when
# __DEV__ is true. A release build ignores them entirely.
EXPO_PUBLIC_DEMO_EMAIL=
EXPO_PUBLIC_DEMO_PASSWORD=
